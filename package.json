{
  "name": "discord-guess-who",
  "version": "1.0.0",
  "description": "Implementation of the Pokémon Guess Who game from PokéErez.com as a Discord bot",
  "keywords": [
    "Pokemon",
    "Discord",
    "Bot",
    "Game",
    "Random"
  ],
  "author": "Erez Bracha",
  "repository": "https://github.com/erezushi/Pokemon-Guess-Who-Discord.git",
  "type": "module",
  "main": "build/index.js",
  "scripts": {
    "dev": "tsx --watch src/index.ts",
    "build": "tsc",
    "start": "npm run build && node .",
    "commands": "tsx src/deploy-commands.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.9",
    "lodash": "^4.18.1",
    "romans": "^3.1.0"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.27",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
